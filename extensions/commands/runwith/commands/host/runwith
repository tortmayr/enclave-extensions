# Installed as `enclave runwith`; model lists cost a container boot, so they are cached per tool.
set -euo pipefail

self_name=$(basename "$0")

usage() {
	cat <<EOF
Usage:
  enclave $self_name <tool> <model> [effort-level] [--no-verify]
  enclave $self_name <tool> --list [search]
  enclave $self_name [tool] --refresh

Start an agent with invocation-specific model and reasoning settings, or list
the models available to the selected harness.

Tools:
  claude  Pass effort with --effort
  codex   Pass effort as the model_reasoning_effort config override
  pi      Pass effort with --thinking

Options:
      --list              List cached models, optionally filtered by a search term
      --refresh           Rebuild the model cache for one tool, or for every tool
      --no-verify         Launch without checking the model against the cache
  -h, --help              Show this help

Listing models requires a container, so results are cached per tool in
\$XDG_CACHE_HOME/enclave/models and refreshed automatically once they are older
than ENCLAVE_MODEL_CACHE_TTL_DAYS days (default 7, 0 disables expiry).

Examples:
  enclave $self_name claude fable
  enclave $self_name claude fable high
  enclave $self_name codex gpt-5.3-codex high
  enclave $self_name pi anthropic/claude-opus-4-6 high
  enclave $self_name claude --list
  enclave $self_name pi --list sonnet
  enclave $self_name pi --refresh
  enclave $self_name --refresh
EOF
}

note() {
	printf 'enclave %s: %s\n' "$self_name" "$*" >&2
}

die() {
	note "$@"
	exit 2
}

TOOLS=(claude codex pi)

cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/enclave/models"
cache_ttl_days=${ENCLAVE_MODEL_CACHE_TTL_DAYS:-7}

cache_file() {
	printf '%s/%s.tsv' "$cache_root" "$1"
}

# With a TTL of 0 only --refresh replaces a cache entry.
cache_is_fresh() {
	local file
	file=$(cache_file "$1")
	[[ -s $file ]] || return 1
	((cache_ttl_days == 0)) && return 0
	[[ -n $(find "$file" -mtime "-$cache_ttl_days" 2>/dev/null) ]]
}

# Each fetch runs in the tool's container and prints one TSV record per model:
# model, effort levels, default effort, description ("-" when absent, so `column -t` stays aligned).
read -r -d '' claude_fetch <<'EOF' || true
printf '%s\n' '{"type":"control_request","request_id":"models","request":{"subtype":"list_models"}}' |
	claude --dangerously-skip-permissions \
		--print \
		--input-format stream-json \
		--output-format stream-json \
		--verbose |
	jq -r '
		# Only one stream line holds the model list; skip the rest instead of aborting.
		select(type == "object")
		| .response.response.models[]?
		| (.value // "") as $value
		| (.resolvedModel // "") as $resolved
		| [$value,
		   (((.supportedEffortLevels // []) | join(",")) | if . == "" then "-" else . end),
		   "-",
		   ([(.displayName // ""),
		     (if $resolved != "" and $resolved != $value then "-> " + $resolved else "" end)]
		    | map(select(. != "")) | join(" ") | if . == "" then "-" else . end)]
		| @tsv
	'
EOF

read -r -d '' codex_fetch <<'EOF' || true
codex --dangerously-bypass-approvals-and-sandbox debug models |
	jq -r '
		select(type == "object")
		| .models[]?
		| select(.visibility == "list")
		| [(.slug // ""),
		   (([.supported_reasoning_levels[]?.effort] | join(",")) | if . == "" then "-" else . end),
		   (.default_reasoning_level // "-"),
		   (.display_name // "-")]
		| @tsv
	'
EOF

# pi prints a table with a yes/no thinking column, so use the fixed --thinking levels from `pi --help`.
read -r -d '' pi_fetch <<'EOF' || true
pi --list-models |
	awk '
		$1 == "provider" && $2 == "model" { seen = 1; next }
		seen && NF >= 6 {
			efforts = ($5 == "yes") ? "off,minimal,low,medium,high,xhigh,max" : "-"
			printf "%s/%s\t%s\t-\tcontext %s, max output %s\n", $1, $2, efforts, $3, $4
		}
	'
EOF

refresh_tool() {
	local tool=$1 fetch script tmp file raw

	case "$tool" in
		claude) fetch=$claude_fetch ;;
		codex) fetch=$codex_fetch ;;
		pi) fetch=$pi_fetch ;;
	esac
	# The markers fence the payload off from anything `enclave shell` prints around it.
	printf -v script 'set -euo pipefail\necho __ENCLAVE_MODELS_BEGIN__\n%s\necho __ENCLAVE_MODELS_END__\n' "$fetch"

	note "listing $tool models (this starts a container)..."

	# `enclave shell` refuses to start without a TTY on stdin, so borrow the controlling terminal.
	if [[ -t 0 ]]; then
		raw=$("$ENCLAVE_BIN" shell --tool "$tool" -- -lc "$script" bash) || raw=
	elif { : </dev/tty; } 2>/dev/null; then
		raw=$("$ENCLAVE_BIN" shell --tool "$tool" -- -lc "$script" bash </dev/tty) || raw=
	else
		die "refreshing the $tool cache needs a terminal; run 'enclave $self_name $tool --refresh' from an interactive shell"
	fi
	[[ -n $raw ]] || die "could not list models for $tool"

	mkdir -p "$cache_root"
	file=$(cache_file "$tool")
	tmp=$(mktemp "$cache_root/.$tool.XXXXXX")
	# TTY output carries CRs and escape codes (one lands right before the end marker), so strip them and match unanchored.
	printf '%s\n' "$raw" | tr -d '\r' | sed $'s/\033\\[[0-9;?]*[a-zA-Z]//g' | awk '
		index($0, "__ENCLAVE_MODELS_BEGIN__") { inside = 1; next }
		index($0, "__ENCLAVE_MODELS_END__")   { inside = 0; next }
		inside && NF                          { print }
	' >"$tmp"

	if [[ ! -s $tmp ]]; then
		rm -f "$tmp"
		die "$tool reported no models; it is probably not logged in inside enclave (try 'enclave --tool $tool')"
	fi

	mv "$tmp" "$file"
	note "cached $(wc -l <"$file" | tr -d ' ') $tool models in $file"
}

cached_rows() {
	local tool=$1
	cache_is_fresh "$tool" || refresh_tool "$tool"
	cat "$(cache_file "$tool")"
}

list_models() {
	local tool=$1 search=$2 rows

	rows=$(cached_rows "$tool" | awk -F'\t' -v search="$search" '
		BEGIN { needle = tolower(search) }
		needle == "" || index(tolower($1 " " $4), needle) { print }
	')

	if [[ -z $rows ]]; then
		printf 'No %s models matching %s\n' "$tool" "$search"
		return
	fi

	{
		printf 'MODEL\tEFFORT\tDEFAULT\tDESCRIPTION\n'
		printf '%s\n' "$rows"
	} | if command -v column >/dev/null 2>&1; then
		column -t -s $'\t'
	else
		cat
	fi
}

# Without a cache this skips the check rather than boot a container before every launch.
verify_selection() {
	local tool=$1 model=$2 effort=$3 file efforts

	file=$(cache_file "$tool")
	[[ -s $file ]] || return 0

	efforts=$(awk -F'\t' -v model="$model" '$1 == model { print $2; exit }' "$file")
	[[ -n $efforts ]] || die "unknown $tool model: $model (run 'enclave $self_name $tool --refresh', or pass --no-verify)"
	[[ -n $effort ]] || return 0
	[[ $efforts != - ]] || die "$tool model $model takes no effort level"
	[[ ",$efforts," == *",$effort,"* ]] || die "unknown effort level for $model: $effort (available: $efforts)"
}

mode=run
verify=true
positionals=()

while (($# > 0)); do
	case "$1" in
		-h | --help)
			usage
			exit 0
			;;
		--list)
			mode=list
			;;
		--refresh)
			mode=refresh
			;;
		--no-verify)
			verify=false
			;;
		--)
			shift
			positionals+=("$@")
			break
			;;
		-*)
			die "unknown option: $1"
			;;
		*)
			positionals+=("$1")
			;;
	esac
	shift
done

[[ -n ${ENCLAVE_BIN:-} ]] || die 'ENCLAVE_BIN is not set'
[[ $cache_ttl_days =~ ^[0-9]+$ ]] || die "ENCLAVE_MODEL_CACHE_TTL_DAYS must be a whole number of days: $cache_ttl_days"
cache_ttl_days=$((10#$cache_ttl_days))

tool=${positionals[0]:-}
args=()
# bash 3.2 treats expanding an empty array as unbound under set -u.
((${#positionals[@]} <= 1)) || args=("${positionals[@]:1}")

if [[ -n $tool && " ${TOOLS[*]} " != *" $tool "* ]]; then
	die "unsupported tool: $tool (expected one of: ${TOOLS[*]})"
fi

if [[ $mode == refresh ]]; then
	((${#args[@]} == 0)) || die '--refresh accepts at most a tool name'
	if [[ -n $tool ]]; then
		refresh_tool "$tool"
		exit 0
	fi
	# A separate process per tool keeps set -e intact and lets one failing tool not stop the rest.
	failed=()
	for one in "${TOOLS[@]}"; do
		"$0" "$one" --refresh || failed+=("$one")
	done
	((${#failed[@]} == 0)) || die "could not refresh: ${failed[*]}"
	exit 0
fi

[[ -n $tool ]] || die "tool is required: ${TOOLS[*]} (see --help)"

if [[ $mode == list ]]; then
	((${#args[@]} <= 1)) || die '--list accepts at most one search term'
	list_models "$tool" "${args[0]:-}"
	exit 0
fi

((${#args[@]} >= 1)) || die 'model name is required'
((${#args[@]} <= 2)) || die 'expected a model name and optional effort level'

model=${args[0]}
effort=${args[1]:-}

if $verify; then
	verify_selection "$tool" "$model" "$effort"
fi

harness_args=(--model "$model")
if [[ -n $effort ]]; then
	case "$tool" in
		claude) harness_args+=(--effort "$effort") ;;
		codex) harness_args+=(-c "model_reasoning_effort=\"$effort\"") ;;
		pi) harness_args+=(--thinking "$effort") ;;
	esac
fi

exec "$ENCLAVE_BIN" --tool "$tool" -- "${harness_args[@]}"
