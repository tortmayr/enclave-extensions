#!/usr/bin/env bash
# Copyright (C) 2026 EclipseSource GmbH and others.
#
# This program and the accompanying materials are made available under the
# terms of the MIT License, which is available in the project root.
#
# SPDX-License-Identifier: MIT

# Run ccusage against persisted Enclave agent sessions. The usage feature
# installs this file as the `enclave usage` host command.
set -euo pipefail

usage() {
	cat <<'EOF'
Usage: enclave usage [WRAPPER OPTIONS] [CCUSAGE ARGUMENTS...]

Run ccusage over persisted Enclave sessions. Arguments not listed below are
passed to ccusage unchanged; without arguments ccusage's default daily report
is used.

Wrapper options:
  -H, --include-host  Also include ordinary host sessions
      --enclave-only  Include only Enclave sessions (default)
      --show-paths    Print discovered native data roots and exit
  -h, --help          Show this help (only recognized as the first argument)

Examples:
  enclave usage monthly
  enclave usage monthly --json --by-agent
  enclave usage --include-host monthly
  enclave usage --show-paths

EOF
}

die() {
	printf 'enclave usage: %s\n' "$*" >&2
	exit 1
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
	usage
	exit 0
fi

include_host=false
show_paths=false
forwarded=()
while (($# > 0)); do
	case "$1" in
		-H | --include-host)
			include_host=true
			;;
		--enclave-only)
			include_host=false
			;;
		--show-paths)
			show_paths=true
			;;
		--)
			shift
			forwarded+=("$@")
			break
			;;
		*)
			forwarded+=("$1")
			;;
	esac
	shift
done

host_home=${HOME:-}
[[ -n $host_home ]] || die 'HOME is not set'
[[ $host_home == /* ]] || die "HOME must be an absolute path: $host_home"

if [[ $(uname -s) == "Darwin" ]]; then
	state_root="$host_home/Library/Application Support/org.eclipse.enclave/state"
elif [[ ${XDG_STATE_HOME:-} == /* ]]; then
	state_root="$XDG_STATE_HOME/enclave"
else
	state_root="$host_home/.local/state/enclave"
fi

# Roots are kept as "<agent>:<path>" in one list, since bash 3.2 has no
# associative arrays.
roots=()

# Add a data root once per canonical path, and only if it holds that agent's
# data. Exact and symlinked duplicates are removed.
add_root() {
	local agent=$1 root=$2 canonical entry
	case "$agent" in
		claude) [[ -d $root/projects ]] ;;
		codex) [[ -d $root/sessions || -d $root/archived_sessions ]] ;;
		*) [[ -d $root ]] ;;
	esac || return 0
	canonical=$(cd -- "$root" >/dev/null 2>&1 && pwd -P) || return 0
	[[ $canonical != *","* ]] || die "ccusage cannot represent a data path containing a comma: $canonical"
	[[ $canonical != *$'\n'* && $canonical != *$'\r'* ]] || die 'data paths must not contain newlines'
	for entry in ${roots[@]+"${roots[@]}"}; do
		[[ $entry != "$agent:$canonical" ]] || return 0
	done
	roots+=("$agent:$canonical")
}

# Print an agent's roots, one per line.
agent_roots() {
	local entry
	for entry in ${roots[@]+"${roots[@]}"}; do
		[[ $entry != "$1:"* ]] || printf '%s\n' "${entry#*:}"
	done
}

shopt -s nullglob
for root in "$state_root"/projects/*/claude/config-store/*; do
	add_root claude "$root"
done
for root in "$state_root"/projects/*/codex/config-store/*; do
	add_root codex "$root"
done
for root in "$state_root"/projects/*/gemini/config-store/*/tmp; do
	add_root gemini "$root"
done
for root in "$state_root"/projects/*/pi/config-store/*/agent/sessions; do
	add_root pi "$root"
done
shopt -u nullglob

if $include_host; then
	add_root claude "$host_home/.config/claude"
	add_root claude "$host_home/.claude"
	add_root codex "$host_home/.codex"
	add_root gemini "$host_home/.gemini/tmp"
	add_root pi "$host_home/.pi/agent/sessions"
fi

print_roots() {
	local paths
	paths=$(agent_roots "$2")
	printf '%s:\n' "$1"
	printf '%s\n' "${paths:-(none)}" | sed 's/^/  /'
}

if $show_paths; then
	if $include_host; then
		printf 'Mode: Enclave and host\n'
	else
		printf 'Mode: Enclave only\n'
	fi
	printf 'State root: %s\n' "$state_root"
	print_roots Claude claude
	print_roots Codex codex
	print_roots Gemini gemini
	print_roots Pi pi
	exit 0
fi

command -v npx >/dev/null 2>&1 || die 'npx is not available'

scratch_dir=$(mktemp -d "${TMPDIR:-/tmp}/enclave-ccusage.XXXXXX")
cleanup() {
	if [[ -n ${scratch_dir:-} && -d $scratch_dir ]]; then
		rm -rf -- "$scratch_dir"
	fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# Join an agent's roots with commas. An explicit, valid empty root prevents
# ccusage from falling back to ordinary host data when an Enclave agent has no
# persisted sessions.
agent_csv() {
	local agent=$1 marker=${2:-} csv
	csv=$(agent_roots "$agent" | paste -sd, -)
	if [[ -z $csv ]]; then
		csv=$scratch_dir/empty/$agent
		mkdir -p "$csv/$marker"
	fi
	printf '%s' "$csv"
}

CLAUDE_CONFIG_DIR=$(agent_csv claude projects)
CODEX_HOME=$(agent_csv codex sessions)
GEMINI_DATA_DIR=$(agent_csv gemini)
PI_AGENT_DIR=$(agent_csv pi)
export CLAUDE_CONFIG_DIR CODEX_HOME GEMINI_DATA_DIR PI_AGENT_DIR

if ! $include_host; then
	# Unified ccusage reports auto-detect many agents. Isolate all default
	# home/XDG locations so Enclave-only means Enclave-only, not merely
	# "custom paths for four agents".
	export HOME="$scratch_dir/home"
	export XDG_CONFIG_HOME="$HOME/.config"
	export XDG_DATA_HOME="$HOME/.local/share"
	export XDG_STATE_HOME="$HOME/.local/state"
	export XDG_CACHE_HOME="$HOME/.cache"
	mkdir -p "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$XDG_CACHE_HOME"

	unset \
		AMP_DATA_DIR ANTIGRAVITY_DATA_DIR CODEBUFF_DATA_DIR COPILOT_HOME \
		COPILOT_OTEL_FILE_EXPORTER_PATH DROID_SESSIONS_DIR GOOSE_PATH_ROOT \
		GROK_HOME HERMES_HOME KILO_DATA_DIR KIMI_DATA_DIR OPENCLAW_DIR \
		OPENCODE_DATA_DIR QWEN_DATA_DIR ZCODE_HOME
fi

# The npm cache stays on the real home so the isolated HOME does not refetch
# ccusage on every run.
npx --yes --cache "$host_home/.npm" ccusage@20.0.45 ${forwarded[@]+"${forwarded[@]}"}
